# Proyecto Unity en la raíz del repo.

# Escenas, prefabs y assets de Unity en texto: fusión con UnityYAMLMerge (Smart Merge).
# Cada uno configura el driver una vez (ver README.md).
*.unity        merge=unityyamlmerge eol=lf
*.prefab       merge=unityyamlmerge eol=lf
*.mat          merge=unityyamlmerge eol=lf
*.anim         merge=unityyamlmerge eol=lf
*.controller   merge=unityyamlmerge eol=lf
*.meta         merge=unityyamlmerge eol=lf
*.terrainlayer merge=unityyamlmerge eol=lf

# Binarios pesados del proyecto Unity: Git LFS (el prototipo de la ciudad queda como estaba)
Assets/**/*.png   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.jpg   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.jpeg  filter=lfs diff=lfs merge=lfs -text
Assets/**/*.psd   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.tga   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.exr   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.fbx   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.blend filter=lfs diff=lfs merge=lfs -text
Assets/**/*.glb   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.wav   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.mp3   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.ogg   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.ttf   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.otf   filter=lfs diff=lfs merge=lfs -text
Assets/**/*.bytes filter=lfs diff=lfs merge=lfs -text

# Datos generados grandes (terreno, mallas)
Assets/Mundo/**/*.asset filter=lfs diff=lfs merge=lfs -text
