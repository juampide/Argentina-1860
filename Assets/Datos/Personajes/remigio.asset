  m_Name: remigio
  m_EditorClassIdentifier: Assembly-CSharp::Argentina1867.FichaPersonaje
  id: remigio
  nombre: Don Rufino Aramburu
  lugar: "De paso por la pulper\xEDa"
  aspecto:
    estilo: 0
    piel: {r: 0.9411765, g: 0.75686276, b: 0.6039216, a: 1}
    pelo: {r: 0.22745098, g: 0.22745098, b: 0.22745098, a: 1}
    peinado: 2
