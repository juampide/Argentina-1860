    ropa2: {r: 0.95686275, g: 0.93333334, b: 0.8627451, a: 1}
    chaleco: {r: 0.5411765, g: 0.5411765, b: 0.5254902, a: 1}
    pantalon: {r: 0.3529412, g: 0.3529412, b: 0.3764706, a: 1}
    poncho: {r: 0.7529412, g: 0.22352941, b: 0.16862746, a: 1}
