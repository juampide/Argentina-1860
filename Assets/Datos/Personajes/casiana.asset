  id: casiana
  nombre: Jacinta Molina
  lugar: Rancho junto al arroyo
  aspecto:
    estilo: 1
    piel: {r: 0.9411765, g: 0.75686276, b: 0.6039216, a: 1}
    pelo: {r: 0.6039216, g: 0.6039216, b: 0.5882353, a: 1}
