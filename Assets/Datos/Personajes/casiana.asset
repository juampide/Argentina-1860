    ropa2: {r: 0.84705883, g: 0.7882353, b: 0.65882355, a: 1}
    chaleco: {r: 0.8509804, g: 0.7058824, b: 0.3529412, a: 1}
    pantalon: {r: 0.5411765, g: 0.5176471, b: 0.47058824, a: 1}
