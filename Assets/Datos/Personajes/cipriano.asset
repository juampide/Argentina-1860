    ropa2: {r: 0.84705883, g: 0.8117647, b: 0.72156864, a: 1}
    chaleco: {r: 0.47843137, g: 0.16470589, b: 0.13333334, a: 1}
    pantalon: {r: 0.5411765, g: 0.5176471, b: 0.47058824, a: 1}
    poncho: {r: 0.7529412, g: 0.22352941, b: 0.16862746, a: 1}
