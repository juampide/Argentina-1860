  m_Script: {fileID: 11500000, guid: 019ad227a4a1147b5ac143c2174def25, type: 3}
  m_Name: fermin
  m_EditorClassIdentifier: Assembly-CSharp::Argentina1867.FichaPersonaje
  id: fermin
  nombre: Anselmo Lucero
  lugar: Corrales de la estancia
  aspecto:
    estilo: 3
    piel: {r: 0.7882353, g: 0.6039216, b: 0.45490196, a: 1}
    pelo: {r: 0.12156863, g: 0.101960786, b: 0.09019608, a: 1}
    peinado: 0
    barba: 0
    bigote: 2
    ropa: {r: 0.18431373, g: 0.22745098, b: 0.33333334, a: 1}
    ropa2: {r: 0.95686275, g: 0.93333334, b: 0.8627451, a: 1}
    chaleco: {r: 0.16470589, g: 0.10980392, b: 0.078431375, a: 1}
    pantalon: {r: 0.5411765, g: 0.5176471, b: 0.47058824, a: 1}
    poncho: {r: 0.2901961, g: 0.2901961, b: 0.3137255, a: 1}
    ponchoAlHombro: 1
    sombrero: 2
    colorSombrero: {r: 0.16470589, g: 0.14117648, b: 0.1254902, a: 1}
    baston: 0
    accesorio: 0
    escala: 1
    contextura: 1.12
    variante: 1
  lineas:
  - "Escuchame bien: ac\xE1 se llega temprano y se trabaja hasta que yo diga. Si hac\xE9s bien lo tuyo, nos vamos a llevar bien."
  - "Hoy hay faena en el corral grande. Ya veremos qu\xE9 sab\xE9s hacer."
  personalidad: "Capataz de La Soledad, el que reparte las tareas. Corto, de \xF3rdenes, con \"che\". Al Gallego le dice \"Gallego\" o \"muchacho\". Duro con los nuevos, pero justo con el que trabaja. Quiere que el trabajo salga y que nadie le discuta."
  sabe: "Todo el trabajo de la estancia: arreo, faena, doma, cuidado de la caballada. Qui\xE9n trabaja bien y qui\xE9n no.\nSecreto: \xE9l tambi\xE9n lleg\xF3 al pago \"sin papeles\", hace a\xF1os. Por eso es tan duro con los nuevos. No lo admite."
  noSabe: "No sabe nada del t\xEDtulo de tierras del Gallego ni de la estafa de la Agencia. No sabe leer. Nada posterior a 1867: ni ferrocarril al pago, ni tel\xE9grafo en el campo, ni alambrado, ni la Conquista del Desierto, ni el fin de la guerra del Paraguay. Tampoco palabras ni ideas de hoy."
